# Copiar a .env.compose en la raíz. No usar estos valores en un entorno público.
POSTGRES_PASSWORD=replace-with-a-local-password
RABBITMQ_USERNAME=rinde
RABBITMQ_PASSWORD=replace-with-a-local-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
RINDE_BILLING_SIMULATION_WEBHOOK_SECRET=replace-with-another-random-secret-of-at-least-32-characters
RINDE_BILLING_SIMULATION_ENABLED=false
WEB_BASE_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORE_PORT=8080
IAM_PORT=8081
TRIP_PORT=8082
GATEWAY_PORT=8000
CORE_VERSION=0.3.0
IAM_VERSION=0.3.0
TRIP_VERSION=0.2.0
GATEWAY_VERSION=0.3.0

RINDE_PLATFORM_JWT_SECRET=replace-with-a-different-secret-of-at-least-32-characters
RINDE_PLATFORM_BOOTSTRAP_ENABLED=false
RINDE_PLATFORM_BOOTSTRAP_NAME=
RINDE_PLATFORM_BOOTSTRAP_EMAIL=
RINDE_PLATFORM_BOOTSTRAP_PASSWORD=

# Buzón privado del operador: desactivado fuera de demostración.
RINDE_DEMO_MAILBOX_ENABLED=false
RINDE_DEMO_MAILBOX_ENCRYPTION_KEY=
