# Copia este archivo como .env en la raíz del gateway y completa los valores.
JWT_SECRET=change-me-to-a-secret-of-at-least-32-characters
IAM_SERVICE_URL=http://localhost:8081
MONOLITH_URL=http://localhost:8080
TRIP_SERVICE_URL=http://localhost:8082
FLEET_SERVICE_URL=http://localhost:8083
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Firma independiente para la administración de Rinde.
RINDE_PLATFORM_JWT_SECRET=replace-with-a-different-secret-of-at-least-32-characters
