# Copia este archivo como .env en la raíz del proyecto y completa los valores.
DB_URL=jdbc:postgresql://localhost:5432/rinde
DB_USERNAME=postgres
DB_PASSWORD=change-me
JWT_SECRET=change-me-with-at-least-32-characters
RINDE_BILLING_SIMULATION_WEBHOOK_SECRET=change-me-with-at-least-32-characters
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RINDE_EVENTS_EXCHANGE=rinde.events
RINDE_NOTIFICATION_QUEUE=notification.trip-assigned
RINDE_IAM_SUBSCRIPTION_QUEUE=iam.subscription-events
IAM_SERVICE_URL=http://localhost:8081
RINDE_IAM_REMOTE_ENABLED=true
# Solo en entornos de prueba: confirma pagos simulados desde la web.
RINDE_BILLING_SIMULATION_ENABLED=false
